[Unit]
Description=Hermes Telegram bot watchdog (availability checks and owner alerts)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermesadmin
Group=hermesadmin
# Dedicated clean checkout pinned to the reviewed commit; see
# platform/docs/HERMES_TELEGRAM_OPERATIONS_RUNBOOK.md.
WorkingDirectory=/home/hermesadmin/hermes-ops/platform/services/api
EnvironmentFile=/home/hermesadmin/.hermes-telegram/ops.env
ExecStart=/usr/bin/node scripts/hermes-telegram-ops.js watchdog
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermesadmin/.hermes-telegram/watchdog
TimeoutStartSec=120
