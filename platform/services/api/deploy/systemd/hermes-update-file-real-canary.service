[Unit]
Description=Hermes update_file one-shot staging canary
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/hermesadmin/hermes-main-readiness/platform/services/api
EnvironmentFile=/home/hermesadmin/.hermes-github-write.env
EnvironmentFile=/home/hermesadmin/.hermes-write-postgres.env
ExecStart=/usr/bin/node scripts/hermes-update-file-real-canary.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermesadmin/hermes-main-readiness
