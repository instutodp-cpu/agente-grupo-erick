{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketingMemory",
  "type": "object",
  "required": [
    "memory_id",
    "kind",
    "scope",
    "evidence_refs",
    "confidence"
  ],
  "properties": {
    "memory_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "evidence",
        "insight",
        "learned_rule"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "brand_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "store_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "statement": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contrary_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}