{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketingLearnedRule",
  "type": "object",
  "required": [
    "rule_id",
    "claim",
    "scope",
    "confidence",
    "supporting_evidence_refs",
    "contrary_evidence_refs",
    "validity",
    "provenance"
  ],
  "properties": {
    "rule_id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "supporting_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contrary_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "validity": {
      "enum": [
        "active",
        "needs_retest",
        "retired"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "promotion_policy",
        "simulation_only"
      ],
      "properties": {
        "promotion_policy": {
          "type": "string"
        },
        "simulation_only": {
          "const": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}