{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketingCreativeBrief",
  "type": "object",
  "required": [
    "brief_id",
    "commercial_objective",
    "audience",
    "evidence_refs",
    "concepts",
    "mode"
  ],
  "properties": {
    "brief_id": {
      "type": "string"
    },
    "commercial_objective": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "product_or_offer": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "const": "draft"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "concept_id",
          "format",
          "hook",
          "cta",
          "rationale",
          "status"
        ],
        "properties": {
          "concept_id": {
            "type": "string"
          },
          "format": {
            "enum": [
              "reel",
              "story",
              "carousel",
              "static_post",
              "ad_creative",
              "whatsapp_asset"
            ]
          },
          "hook": {
            "type": "string"
          },
          "structure": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cta": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hypotheses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "hypothesis",
              "evidence_backed"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}