{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketingContentPackage",
  "type": "object",
  "required": [
    "content_id",
    "format",
    "commercial_objective",
    "cta",
    "status",
    "blocks"
  ],
  "properties": {
    "content_id": {
      "type": "string"
    },
    "format": {
      "enum": [
        "reel",
        "story",
        "carousel",
        "static_post",
        "ad_creative",
        "whatsapp_asset"
      ]
    },
    "commercial_objective": {
      "type": "string"
    },
    "cta": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_facts_missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "asset_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "blocked_missing_facts",
        "ready_for_qa"
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "role",
          "content"
        ],
        "properties": {
          "block_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "hook",
              "spoken_line",
              "on_screen_text",
              "visual_direction",
              "story_frame",
              "carousel_slide",
              "body_copy",
              "cta",
              "disclaimer"
            ]
          },
          "content": {
            "type": "string"
          },
          "duration_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}