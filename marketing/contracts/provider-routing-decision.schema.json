{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketingProviderRoutingDecision",
  "type": "object",
  "required": [
    "capability",
    "decision",
    "health_evidence_ref",
    "simulation",
    "external_execution"
  ],
  "properties": {
    "capability": {
      "type": "string"
    },
    "selected_adapter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "enum": [
        "route_simulated",
        "blocked_unavailable",
        "blocked_unknown",
        "blocked_capability"
      ]
    },
    "health_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "simulation": {
      "const": true
    },
    "external_execution": {
      "const": false
    }
  },
  "additionalProperties": false
}