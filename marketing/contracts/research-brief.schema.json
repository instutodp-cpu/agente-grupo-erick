{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketingResearchBrief",
  "type": "object",
  "required": [
    "research_id",
    "objective",
    "questions",
    "status"
  ],
  "properties": {
    "research_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "requires_current_research": {
      "type": "boolean"
    },
    "source_preferences": {
      "type": "array",
      "items": {
        "enum": [
          "official",
          "primary",
          "first_party_internal",
          "secondary",
          "community"
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "planned",
        "collecting",
        "sufficient",
        "insufficient_evidence",
        "completed"
      ]
    },
    "recommendation": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}