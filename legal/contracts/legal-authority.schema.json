{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalAuthority",
  "type": "object",
  "required": [
    "authority_id",
    "authority_type",
    "jurisdiction",
    "issuer",
    "identifier",
    "publication_date",
    "status",
    "source_snapshot_ref"
  ],
  "properties": {
    "authority_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_type": {
      "enum": [
        "constitution",
        "law",
        "complementary_law",
        "decree",
        "regulation",
        "resolution",
        "ordinance",
        "precedent",
        "binding_precedent",
        "other"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "lexml_urn": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_date": {
      "type": "string",
      "format": "date"
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effective_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "status": {
      "enum": [
        "published_not_effective",
        "effective",
        "partially_effective",
        "suspended",
        "revoked",
        "expired",
        "unknown"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_snapshot_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
