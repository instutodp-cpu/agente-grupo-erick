{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalRetrievalQuery",
  "type": "object",
  "required": [
    "query_id",
    "text",
    "jurisdiction",
    "as_of",
    "purpose"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "purpose": {
      "enum": [
        "discovery",
        "legal_authority",
        "precedent",
        "process_metadata",
        "internal_fact"
      ]
    },
    "matter_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "additionalProperties": false
}
