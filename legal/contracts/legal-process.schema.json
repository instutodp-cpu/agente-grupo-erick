{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalProcess",
  "type": "object",
  "required": [
    "process_id",
    "matter_scope",
    "jurisdiction",
    "court",
    "source_id",
    "source_snapshot_ref",
    "status"
  ],
  "properties": {
    "process_id": {
      "type": "string",
      "minLength": 1
    },
    "matter_scope": {
      "type": "string",
      "minLength": 1
    },
    "external_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "court": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "closed",
        "unknown"
      ]
    },
    "party_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
