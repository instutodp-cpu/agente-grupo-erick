{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalEvidenceBundle",
  "type": "object",
  "required": [
    "bundle_id",
    "matter_scope",
    "claims",
    "source_refs",
    "created_at",
    "review_status"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "matter_scope": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contrary_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "verified",
        "conflicted",
        "insufficient"
      ]
    },
    "draft_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_run_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
