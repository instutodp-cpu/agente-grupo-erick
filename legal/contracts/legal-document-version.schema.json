{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalDocumentVersion",
  "type": "object",
  "required": [
    "version_id",
    "document_id",
    "content_hash",
    "created_at",
    "source_snapshot_ref",
    "extraction_status"
  ],
  "properties": {
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "minLength": 16
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "previous_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "extraction_status": {
      "enum": [
        "pending",
        "extracted",
        "partial",
        "failed"
      ]
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "additionalProperties": false
}
