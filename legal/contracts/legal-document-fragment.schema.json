{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalDocumentFragment",
  "type": "object",
  "required": [
    "fragment_id",
    "document_id",
    "version_id",
    "text",
    "content_hash",
    "locator",
    "extraction_method",
    "confidence"
  ],
  "properties": {
    "fragment_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "minLength": 16
    },
    "locator": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "page",
            "paragraph",
            "section",
            "character_range",
            "unknown"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "extraction_method": {
      "enum": [
        "native_text",
        "structured_parse",
        "ocr",
        "manual",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_snapshot_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
