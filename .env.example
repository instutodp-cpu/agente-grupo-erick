# Copie este arquivo para .env e preencha as variáveis.
# Usado apenas por `npm run validate:templates` (scripts/validate-templates.js).
# O chat web v1 (server.js) foi aposentado em 2026-11; o runtime operacional
# do Hermes fica em platform/ (bot Telegram + API).

# Connection string do Supabase de dados das lojas (Session Pooler).
# Prefira um papel somente leitura, nunca o usuário postgres.
DATABASE_URL=postgresql://USUARIO_SOMENTE_LEITURA.yxmdrrwqxwzsdgcgskrm:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Timeout (ms) por consulta no script de validação dos SQL Templates — opcional
SQL_TEMPLATE_VALIDATION_TIMEOUT_MS=30000

# Hermes histórico empresarial (desligado por padrão; somente staging).
# A troca comercial exige uma relation allowlisted e o cut start correspondente.
# HERMES_HISTORY_COMMERCIAL_VIEW=hermes_history.monthly_commercial_v2
# HERMES_HISTORY_COMMERCIAL_CUT_START=
# HERMES_HISTORY_SELLER_ENABLED=false
# HERMES_HISTORY_SELLER_VIEW=hermes_history.monthly_seller_activity_v1
